# Copie este arquivo para .env e preencha com a sua chave.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# Chave da API da Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Opcional: modelo usado na análise (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
